NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gmail SMTP testing. Use a Gmail App Password, not your normal account password.
AUTH_EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
MAILTRAP_API_TOKEN=replace-with-mailtrap-token
RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=JobHive <your-gmail-address@gmail.com>

# Used only by scripts/create-admin.mjs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=JobHive Admin
